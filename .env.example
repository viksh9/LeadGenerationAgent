APP_NAME=LeadGenerationAgent
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/leads.db
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Real-data-only enforcement. When true, write guards reject synthetic/demo
# records and REAL leads with no source-backed evidence. Leave unset to derive
# from APP_ENV (on in production/staging, off in development/test).
ENFORCE_REAL_DATA=
# Show synthetic leads in the API by default (development only). Leave unset to
# derive from APP_ENV (off in production).
SHOW_SYNTHETIC_LEADS=

# Adzuna jobs collector (placeholders — never commit real credentials).
# Obtain from https://developer.adzuna.com/. The app starts without these; the
# collector reports NOT_CONFIGURED until app id + key are set.
ADZUNA_API_BASE_URL=https://api.adzuna.com/v1/api
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Controlled query strategy (protects the API quota — replaces blind
# roles×locations×pages fan-out). Mode: ROLE_FIRST (default) | TECHNOLOGY_FIRST |
# LOCATION_FIRST. MAX_REQUESTS_PER_RUN is a hard per-run cap.
ADZUNA_SEARCH_MODE=ROLE_FIRST
ADZUNA_MAX_REQUESTS_PER_RUN=30
ADZUNA_LOOKBACK_DAYS=7
ADZUNA_RESULTS_PER_PAGE=20
ADZUNA_MAX_PAGES=5
ADZUNA_REQUESTS_PER_MINUTE=20
ADZUNA_DAILY_REQUEST_LIMIT=200
ADZUNA_TIMEOUT_SECONDS=15
ADZUNA_INTEGRATION_TEST=false

# Jooble jobs collector (placeholder — never commit a real key). Get a key at
# https://jooble.org/api/about. Keys are PER-COUNTRY: an India key from
# in.jooble.org is required for Indian listings (set JOOBLE_API_HOST=in.jooble.org).
# The FREE plan is a hard 500-request LIFETIME cap per key. Status stays
# NOT_CONFIGURED until JOOBLE_API_KEY is set and CONNECTED only after a live check.
JOOBLE_API_KEY=
JOOBLE_API_HOST=jooble.org
JOOBLE_LOCATION=India
JOOBLE_MAX_PAGES=3
JOOBLE_RESULTS_PER_PAGE=20
JOOBLE_REQUESTS_PER_MINUTE=10
JOOBLE_DAILY_REQUEST_LIMIT=100
JOOBLE_TIMEOUT_SECONDS=15

# Company career-page collector (no credentials — public pages only). These are
# policy/safety knobs with conservative defaults; per-company sources live in
# config/career_sources.yaml. See docs/sources/company-career-pages.md.
CAREER_USER_AGENT=LeadGenerationAgent/0.1 (+contact@example.com)
CAREER_REQUESTS_PER_MINUTE=10
CAREER_MAX_PAGES=3
CAREER_MAX_RECORDS=200
CAREER_MAX_RESPONSE_SIZE_MB=5
CAREER_MAX_REDIRECTS=3
CAREER_LOOKBACK_DAYS=30
CAREER_ALLOW_PRIVATE_HOSTS=false
CAREER_ALLOWLISTED_HOSTS=
CAREER_PAGE_INTEGRATION_TEST=false
CAREER_PAGE_TEST_URL=

# Official ATS / career sources (public APIs — NO credentials/keys required).
# Provide known company board identifiers (comma-separated). NEVER invent boards;
# leave blank until a legitimate board is discovered (status = DISCOVERY_REQUIRED).
# Greenhouse board tokens: e.g. GREENHOUSE_BOARDS=acmecorp,othercompany
GREENHOUSE_BOARDS=
# Lever site handles: e.g. LEVER_SITES=acmecorp,othercompany
LEVER_SITES=

# Jooble lifetime request budget (free plan = 500 requests per key, ABSOLUTE).
# The app persists usage and stops cleanly when the budget is exhausted.
JOOBLE_LIFETIME_REQUEST_BUDGET=500

# AI reasoning layer (placeholders — never commit a real key). The AI is a
# REASONING layer over already-verified real data, never a source of facts. The
# deterministic grounded baseline (ai/deterministic.py) works with NONE of these
# set — with no provider the layer still produces structured, evidence-cited
# output from real DB records. Status stays NOT_CONFIGURED until a provider + key
# are set, and CONNECTED only after a real model probe. Any OpenAI-compatible
# /chat/completions endpoint works. Credentials come from the env only.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_ENABLED=

# Continuous monitoring & scheduling layer. The background scheduler runner is
# OFF by default: with SCHEDULER_ENABLED unset/false, importing the app, running
# tests, or CI spawns NO threads and makes NO network calls. Set it to true to
# start the in-process asyncio runner that periodically ticks due jobs (real
# collection still only happens for sources that are actually configured).
SCHEDULER_ENABLED=false
# Display/label timezone for schedules (timestamps are stored in UTC). Defaults
# to Asia/Kolkata for the Indian-IT focus.
SCHEDULER_TIMEZONE=Asia/Kolkata
# How often (seconds) the background runner checks for due jobs.
SCHEDULER_TICK_SECONDS=60
# First-ever admin guard (placeholder — never commit a real key). Empty => the
# scheduler control endpoints (run/pause/resume) are OPEN (local single-user
# default). When set, those mutating endpoints require a matching X-Admin-Key
# header (constant-time compare; never logged). Credentials come from the env only.
# This same key is the app-wide RBAC admin key (api/security.py): when set, guarded
# mutations require X-Admin-Key (ADMIN) or an X-Role header; when unset the app is
# fully open (local single-user default).
ADMIN_API_KEY=

# --- CRM & outreach lifecycle (Prompt 39) ---------------------------------- #
# Placeholders only — NEVER commit real credentials. See docs/crm-outreach.md.
#
# NO message is ever sent unless BOTH are true: (1) an email provider is fully
# configured below, AND (2) a human has explicitly APPROVED the specific draft.
# With everything left blank the app still drafts and approves outreach — it just
# physically cannot send (email_config_status = NOT_CONFIGURED). There is no bulk
# send and no auto-send anywhere.

# Email provider selector. Blank => NOT_CONFIGURED (cannot send). The only fully
# implemented provider is SMTP (stdlib smtplib — no third-party SDK). The names
# SENDGRID / GRAPH / GMAIL are recognised but NOT implemented; setting one leaves
# the app NOT_CONFIGURED (it refuses to pretend it can send).
EMAIL_PROVIDER=
# From address for outbound mail (required for any provider to be CONFIGURED).
EMAIL_FROM=
# API key for API-key providers (SendGrid/Graph/Gmail API) — unused by SMTP and
# unused until such a provider is implemented. Env only; never logged.
EMAIL_API_KEY=
# SMTP transport settings (used only when EMAIL_PROVIDER=SMTP). SMTP is CONFIGURED
# when SMTP_HOST and EMAIL_FROM are set; login is used only if username+password
# are both present.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on the SMTP connection. Keep true unless your relay requires otherwise.
SMTP_USE_TLS=true
# Send-safety caps (never mass-sends). Daily cap across all sends + per-minute
# rate limit; a send that would exceed either is refused, not queued.
EMAIL_DAILY_LIMIT=100
EMAIL_RATE_PER_MINUTE=10
# Require a SOURCE-VERIFIED business email on the recipient contact before sending
# (safety). Leave true in production; set false only for controlled testing.
OUTREACH_REQUIRE_VERIFIED_EMAIL=true

# CRM provider. INTERNAL (default) means the local database IS the CRM — always
# available, no external calls. External connectors (Salesforce/HubSpot/Zoho/…)
# are NOT implemented in this phase: naming one still uses the internal CRM rather
# than faking an external connection. Credentials come from the env only.
CRM_PROVIDER=INTERNAL
CRM_API_KEY=
CRM_BASE_URL=

# Inbound webhook signing (email delivery/bounce/reply events). When WEBHOOK_SECRET
# is UNSET, the signed webhook endpoints FAIL CLOSED and reject every request —
# unsigned payloads are never trusted. When set, each request must carry a valid
# HMAC-SHA256 X-Signature over "{X-Timestamp}.{raw body}" and a fresh X-Timestamp
# (replay protection). Never commit a real secret.
WEBHOOK_SECRET=
# Max clock skew (seconds) allowed between X-Timestamp and now (replay window).
WEBHOOK_TOLERANCE_SECONDS=300
